# Copy to .env.local for local development. In production, set these in Vercel.
# Generate secrets with:  npm run secrets

# Public URL of the app (exact origin; used for passkeys and origin checks)
APP_ORIGIN=http://localhost:3000

# Postgres connection string (Supabase: Project Settings -> Database -> Connection pooling, port 6543)
DATABASE_URL=postgres://tracker:tracker@localhost:54329/tracker

# One-time token required to create the first passkey. Remove or rotate after setup.
SETUP_TOKEN=

# 32-byte base64 key used to encrypt bank tokens at rest (AES-256-GCM)
TOKEN_ENC_KEY=

# Secret Vercel Cron sends as a Bearer token
CRON_SECRET=
